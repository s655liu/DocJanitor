# Auto-Doc Janitor - Environment Template
# Copy this to .env and fill in your keys

# CLōD API Key (Required for AI Summarization)
CLOD_API_KEY=your_clod_key_here

# Nia by Nozomio (Optional - enables semantic context grounding before AI calls)
NIA_API_KEY=your_nia_key_here

# Optional: Path to the directory you want to watch
# Defaults to the project root if not set
WATCH_PATH=.
